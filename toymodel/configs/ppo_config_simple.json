{
  "experiment": {
    "name": "ppo_simple_predictor",
    "description": "PPO training with simple latency predictor",
    "seed": 42
  },
  "environment": {
    "num_replicas": 2,
    "max_time": 500.0,
    "service_rates": {
      "0": {"0": 10.0, "1": 5.0},
      "1": {"0": 5.0, "1": 10.0}
    },
    "arrival_rates": {
      "0": 6.0,
      "1": 6.0
    }
  },
  "scheduler": {
    "type": "ppo",
    "options": {
      "n_requests": 3
    }
  },
  "metrics": {
    "save_csv": true,
    "csv_path": "toymodel/outputs/simple_predictor/metrics.csv",
    "save_raw_data": true
  },
  "ppo": {
    "n_requests": 3,
    "hidden_dim": 64,
    "learning_rate": 1e-4,
    "clip_ratio": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 0.1,
    "epochs": 4,
    "minibatch_size": 64,
    "max_grad_norm": 0.5,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "rollout_length": 32,
    "num_episodes": 1000,
    "eval_interval": 20,
    "save_interval": 50,
    "max_episode_length": 32,
    "latency_weight": 1,
    "use_prediction": true,
    "prediction_weight": 1,
    "predictor_type": "simple",
    "impact_weight": 0
  },
  "tensorboard": {
    "enabled": true,
    "log_dir": "toymodel/outputs/simple_predictor/tensorboard",
    "port": 6006
  },
  "output": {
    "dir": "toymodel/outputs/simple_predictor"
  }
}
