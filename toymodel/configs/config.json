{
  "experiment": {
    "name": "toymodel_experiment",
    "description": "Toy model M/M/1 queue simulation for PPO routing validation",
    "seed": 42
  },
  "environment": {
    "num_replicas": 2,
    "max_time": 500.0,
    "service_rates": {
      "0": {
        "0": 10.0,
        "1": 5.0
      },
      "1": {
        "0": 5.0,
        "1": 10.0
      }
    },
    "arrival_rates": {
      "0": 6.0,
      "1": 6.0
    }
  },
  "scheduler": {
    "type": "oracle",
    "options": {}
  },
  "metrics": {
    "save_csv": true,
    "csv_path": "toymodel/outputs/metrics/experiment_metrics.csv",
    "save_raw_data": false
  },
  "tensorboard": {
    "enabled": true,
    "log_dir": "toymodel/outputs/tensorboard",
    "port": 6006,
    "clean_previous_runs": true
  }
}
